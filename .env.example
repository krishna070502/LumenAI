# Neon Database Configuration
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Neon Auth Configuration  
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/dbname/auth

# Admin Configuration
# Set this to your email address to enable admin access to Models and Search settings
ADMIN_EMAIL=your-admin-email@example.com

# Next.js
NEXT_PUBLIC_VERSION=1.12.1

# Docker deployments (docker-compose.dokploy.yaml / docker-compose.coolify.yaml)
# Public URL of the deployed app, e.g. https://lumen.example.com
NEXT_PUBLIC_APP_URL=https://lumen.example.com
# Dokploy only (Coolify auto-generates it). Generate with: openssl rand -hex 32
SEARXNG_SECRET=change-me
